    classDef harness fill:#e0f3ef,stroke:#278373,color:#153f37,stroke-width:1.5px;
    classDef learn fill:#fff1d9,stroke:#b9842b,color:#513a17,stroke-width:1.5px;
    classDef base fill:#f2f4f7,stroke:#778397,color:#263445,stroke-width:1.2px;
    class P,G core;
    class H,K harness;
    class D,L,V,Z learn;
    class E,W base;
